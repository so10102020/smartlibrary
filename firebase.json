{
  "firestore": {
    "database": "(default)",
    "location": "asia-northeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/user/index.html"
      },
      {
        "source": "/login",
        "destination": "/auth/login.html"
      },
      {
        "source": "/signup",
        "destination": "/auth/signup.html"
      },
      {
        "source": "/admin",
        "destination": "/admin/admin.html"
      }
    ]
  }
}
